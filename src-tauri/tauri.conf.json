{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOOKSHELL",
  "version": "1.9.2",
  "identifier": "dev.bookshell.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BOOKSHELL",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": [
          "fontconfig"
        ]
      },
      "rpm": {
        "depends": [
          "fontconfig"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGRTI5RkJFMUVCMDg4RjcKUldUM2lMQWV2cC9pejNvSDcvc2tCM1c5VWNmVjBoSlgrNnZoNmNpTFNkSExJTzh3a0dYL0tCby8K",
      "endpoints": [
        "https://github.com/craig7351/bookshell/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
