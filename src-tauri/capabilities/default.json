{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-request-user-attention",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
